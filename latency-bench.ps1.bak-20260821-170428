# latency-bench.ps1 - one-shot network latency test suite for Fortnite.
# 1. gateway ICMP (local path health)
# 2. 1.1.1.1 ICMP (internet edge)
# 3. AWS us-west-2 TCP handshake (Fortnite NA-West region; AWS blocks ICMP)
# 4. DNS resolve timing for Epic domains
# 5. bufferbloat: gateway ping idle vs under a 25MB download load
# Writes reports\bench-<stamp>.md and prints a summary.

$ErrorActionPreference = 'Continue'
$gw = (Get-NetRoute -DestinationPrefix '0.0.0.0/0' | Sort-Object RouteMetric | Select-Object -First 1).NextHop

function Icmp-Stats([string]$h, [int]$n) {
  $p = Test-Connection $h -Count $n -ErrorAction SilentlyContinue
  $r = @($p | ForEach-Object ResponseTime)
  if ($r.Count -eq 0) { return @{ n = 0 } }
  $s = $r | Measure-Object -Minimum, -Maximum, -Average
  @{ n = $r.Count; min = $s.Minimum; max = $s.Maximum; avg = [math]::Round($s.Average,1); spread = $s.Maximum - $s.Minimum; samples = $r }
}

function Tcp-Stats([string]$h, [int]$n) {
  $t = @()
  foreach ($i in 1..$n) {
    $c = New-Object System.Net.Sockets.TcpClient
    $sw = [System.Diagnostics.Stopwatch]::StartNew()
    try { $c.Connect($h, 443); $sw.Stop(); $t += [int]$sw.ElapsedMilliseconds } catch {}
    finally { $c.Close() }
    Start-Sleep -Milliseconds 150
  }
  if ($t.Count -eq 0) { return @{ n = 0 } }
  $s = $t | Measure-Object -Minimum, -Maximum, -Average
  $sorted = $t | Sort-Object
  $p95 = $sorted[[int][math]::Floor(0.95 * ($sorted.Count - 1))]
  @{ n = $t.Count; min = $s.Minimum; max = $s.Maximum; avg = [math]::Round($s.Average,1); p95 = $p95; spread = $s.Maximum - $s.Minimum }
}

function Dns-Stats([string]$h) {
  $t = @()
  foreach ($i in 1..3) {
    $sw = [System.Diagnostics.Stopwatch]::StartNew()
    Resolve-DnsName $h -ErrorAction SilentlyContinue | Out-Null
    $sw.Stop(); $t += [int]$sw.ElapsedMilliseconds
  }
  @{ avg = [math]::Round(($t | Measure-Object -Average).Average,0); max = ($t | Measure-Object -Maximum).Maximum }
}

Write-Host "=== 1. gateway (local path) ==="         -ForegroundColor Cyan
$g = Icmp-Stats $gw 30
Write-Host ("  {0}: avg {1} ms, spread {2} ms (n={3})" -f $gw, $g.avg, $g.spread, $g.n)

Write-Host "=== 2. 1.1.1.1 (internet edge) ==="      -ForegroundColor Cyan
$c = Icmp-Stats '1.1.1.1' 30
Write-Host ("  avg {0} ms, spread {1} ms (n={2})" -f $c.avg, $c.spread, $c.n)

Write-Host "=== 3. us-west-2 :443 (Fortnite NAW region) ===" -ForegroundColor Cyan
$u = Tcp-Stats 'ec2.us-west-2.amazonaws.com' 15
Write-Host ("  min {0} / avg {1} / p95 {2} / max {3} ms (n={4})" -f $u.min, $u.avg, $u.p95, $u.max, $u.n)

Write-Host "=== 4. DNS timing ==="                   -ForegroundColor Cyan
$d1 = Dns-Stats 'fortnite.com'
$d2 = Dns-Stats 'ol.epicgames.com'
Write-Host ("  fortnite.com avg {0} ms (max {1}) | ol.epicgames.com avg {2} ms (max {3})" -f $d1.avg, $d1.max, $d2.avg, $d2.max)

Write-Host "=== 5. bufferbloat (gateway ping under load) ===" -ForegroundColor Cyan
$idle = Icmp-Stats $gw 10
Write-Host ("  idle:   avg {0} ms, spread {1} ms" -f $idle.avg, $idle.spread)
$job = Start-Job { try { Invoke-WebRequest -Uri 'https://speed.cloudflare.com/__down?bytes=25000000' -UseBasicParsing -TimeoutSec 60 | Out-Null } catch {} }
Start-Sleep -Seconds 2
$loaded = Icmp-Stats $gw 25
Wait-Job $job -Timeout 60 | Out-Null; Remove-Job $job -Force
$del = $loaded.avg - $idle.avg
$grade = if ($loaded.spread -lt 5 -and $del -lt 5) { 'A' } elseif ($loaded.spread -lt 15 -and $del -lt 15) { 'B' } elseif ($loaded.spread -lt 40) { 'C' } else { 'F' }
Write-Host ("  loaded: avg {0} ms, spread {1} ms  ->  bufferbloat grade {2}" -f $loaded.avg, $loaded.spread, $grade) -ForegroundColor $(if ($grade -eq 'A') {'Green'} elseif ($grade -eq 'F') {'Red'} else {'Yellow'})

$stamp = Get-Date -Format 'yyyyMMdd-HHmmss'
$repDir = Join-Path $PSScriptRoot 'reports'; New-Item -ItemType Directory -Path $repDir -Force | Out-Null
$rep = Join-Path $repDir ("bench-" + $stamp + ".md")
@"
# Latency bench $stamp

- gateway $gw ICMP: avg $($g.avg) ms, spread $($g.spread) ms (n=$($g.n))
- 1.1.1.1 ICMP: avg $($c.avg) ms, spread $($c.spread) ms (n=$($c.n))
- us-west-2 TCP:443: min $($u.min) / avg $($u.avg) / p95 $($u.p95) ms (n=$($u.n))
- DNS: fortnite.com $($d1.avg) ms, ol.epicgames.com $($d2.avg) ms
- bufferbloat: idle avg $($idle.avg)/spread $($idle.spread) -> loaded avg $($loaded.avg)/spread $($loaded.spread), grade $grade

Interpretation: gateway spread under 5 ms and us-west-2 avg in the 30-55 ms band = healthy
NA-West path. Bufferbloat grade below A = router SQM would help (cannot be fixed from the PC).
"@ | Out-File $rep -Encoding utf8
Write-Host ("Report saved: " + $rep) -ForegroundColor Cyan
